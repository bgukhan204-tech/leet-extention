# ==============================================================================
# LeetCode2Git - Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git or expose these values to the Chrome extension frontend.
# ==============================================================================

# Server Port
PORT=5000

# Environment Mode: 'development' | 'production' | 'test'
NODE_ENV=development

# MongoDB Connection URI
# Development (Local): mongodb://localhost:27017/leetcode2git
# Production (MongoDB Atlas): mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/leetcode2git?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/leetcode2git

# ==============================================================================
# GitHub OAuth Application (Registered by LeetCode2Git Application Owner)
# Create at https://github.com/settings/developers -> OAuth Apps
# ==============================================================================
GITHUB_CLIENT_ID=your_github_oauth_client_id_here
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret_here

# Backend Base URL (Used for generating redirects & health checks)
# Development: http://localhost:5000
# Production: https://api.leetcodetogit.com
BACKEND_URL=http://localhost:5000

# OAuth Callback URL (Must match the Authorization callback URL in your GitHub OAuth App)
# Development: http://localhost:5000/api/auth/github/callback
# Production: https://api.leetcodetogit.com/api/auth/github/callback
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# JWT Signing Secret (Generate a strong random string for production)
JWT_SECRET=dev_jwt_secret_leetcode2git_multi_user_key_98765
JWT_EXPIRES_IN=30d

# CORS & Extension Configuration
# Allowed origins (supports chrome-extension://*, localhost, or specific production domains)
CORS_ORIGIN=*
FRONTEND_URL=
